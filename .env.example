# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Backend ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

ENVIRONMENT=development
DEBUG=true

# ── AI backend (OpenAI-compatible) ────────────────────────────────────────────
# Option A — OpenAI (paid, credit card required)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option B — Groq (free tier, no credit card)
# Sign up at https://console.groq.com → API Keys → Create key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_...
OPENAI_MODEL=llama-3.1-8b-instant

# ── Content ingestion ─────────────────────────────────────────────────────────
# YouTube Data API v3 — https://console.cloud.google.com
YOUTUBE_API_KEY=

# Podcast Index API — https://api.podcastindex.org
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Admin endpoint protection — generate with: openssl rand -hex 32
ADMIN_API_KEY=

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
